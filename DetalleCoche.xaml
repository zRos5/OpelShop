<Window x:Class="OpelShop.DetalleCoche"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del modelo" Width="800" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" KeyDown="Ventana_KeyDown">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="340"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Foto -->
		<Grid Grid.Column="0" Background="#E9E9E9">
			<Image Source="{Binding Imagen}" Stretch="Uniform" VerticalAlignment="Center"
                   AutomationProperties.Name="{Binding Nombre}"/>
		</Grid>

		<!-- Información -->
		<StackPanel Grid.Column="1" Margin="32">
			<TextBlock Text="{Binding Nombre}" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource Negro}" TextWrapping="Wrap"/>
			<TextBlock Text="{Binding Tipo}" FontSize="16" Foreground="#666666" Margin="0,2,0,0"/>
			<TextBlock Text="{Binding PrecioTexto}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource Negro}" Margin="0,12,0,16"/>

			<TextBlock Text="{Binding Descripcion}" FontSize="15" TextWrapping="Wrap"
                       Foreground="#333333"/>

			<TextBlock Text="Características" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource Negro}" Margin="0,20,0,6"/>
			<ItemsControl ItemsSource="{Binding Caracteristicas}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="15"
                                   Margin="0,2,0,0" Foreground="#333333"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<Button Content="Cerrar" Width="140" HorizontalAlignment="Left" Margin="0,28,0,0"
                    Style="{StaticResource BotonPrimario}" Click="Cerrar_Click"/>
		</StackPanel>
	</Grid>
</Window>