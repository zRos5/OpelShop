<Page x:Class="OpelShop.Inicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inicio">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="32">

			<!-- Banner: oferta de temporada -->
			<Border Background="{StaticResource Negro}" CornerRadius="8" Padding="40">
				<StackPanel MaxWidth="560" HorizontalAlignment="Left">
					<TextBlock x:Name="txtSaludo" Visibility="Collapsed" FontSize="18"
                               FontWeight="SemiBold" Foreground="{StaticResource Amarillo}"
                               Margin="0,0,0,12"/>
					<Border Background="{StaticResource Amarillo}" CornerRadius="4"
                            Padding="10,4" HorizontalAlignment="Left">
						<TextBlock Text="OFERTA DE INVIERNO" FontWeight="Bold" FontSize="12"
                                   Foreground="{StaticResource Negro}"/>
					</Border>
					<TextBlock Text="Estrena tu Opel eléctrico" FontSize="36" FontWeight="Bold"
                               Foreground="White" Margin="0,16,0,8" TextWrapping="Wrap"/>
					<TextBlock Text="Condiciones especiales en modelos seleccionados hasta fin de mes."
                               FontSize="16" Foreground="#DDDDDD" TextWrapping="Wrap"/>
					<Button Content="Ver productos" Width="180" HorizontalAlignment="Left"
                            Margin="0,24,0,0" Style="{StaticResource BotonPrimario}"
                            Click="VerProductos_Click"/>
				</StackPanel>
			</Border>

			<!-- Novedades -->
			<TextBlock Text="Novedades" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource Negro}" Margin="0,32,0,16"/>
			<ItemsControl x:Name="listaNovedades" ItemTemplate="{StaticResource TarjetaCoche}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>

			<!-- Mejores precios -->
			<TextBlock Text="Mejores precios" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource Negro}" Margin="0,16,0,16"/>
			<ItemsControl x:Name="listaPrecios" ItemTemplate="{StaticResource TarjetaCoche}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>

		</StackPanel>
	</ScrollViewer>
</Page>