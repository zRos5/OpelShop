<Page x:Class="OpelShop.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Acceso">
	<Grid>
		<Border Width="400" Padding="32" Background="White" CornerRadius="8"
                BorderBrush="#DDDDDD" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
			<Border.RenderTransform>
				<TranslateTransform x:Name="desplazamiento"/>
			</Border.RenderTransform>
			<StackPanel>
				<TextBlock Text="Acceso de clientes" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource Negro}"/>
				<TextBlock Text="Inicia sesión para ver tus ofertas."
                           Margin="0,4,0,24" Foreground="#555555"/>

				<TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,0,0,4"/>
				<TextBox x:Name="txtUsuario" Height="36" FontSize="16" Padding="8,6"
                         TabIndex="0" AutomationProperties.Name="Usuario"/>

				<TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,16,0,4"/>
				<PasswordBox x:Name="txtPassword" Height="36" FontSize="16" Padding="8,6"
                             MaxLength="30" TabIndex="1"
                             AutomationProperties.Name="Contraseña"/>

				<!-- Mensaje de error (oculto por defecto) -->
				<Border x:Name="panelError" Visibility="Collapsed" Background="#FDECEA"
                        BorderBrush="#B00020" BorderThickness="1" CornerRadius="4"
                        Padding="10,8" Margin="0,16,0,0">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="⚠" Foreground="#B00020" FontSize="16" Margin="0,0,8,0"/>
						<TextBlock x:Name="txtError" Foreground="#B00020"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<!-- Mensaje de éxito (oculto por defecto) -->
				<Border x:Name="panelOk" Visibility="Collapsed" Background="#EAF6EC"
                        BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="4"
                        Padding="10,8" Margin="0,16,0,0">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="✔" Foreground="#2E7D32" FontSize="16" Margin="0,0,8,0"/>
						<TextBlock Text="Acceso correcto. ¡Bienvenido!" Foreground="#2E7D32"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</Border>

				<Button Content="Entrar" IsDefault="True" Click="Entrar_Click"
                        Style="{StaticResource BotonPrimario}" Margin="0,24,0,0" TabIndex="2"/>

				<TextBlock Text="Usuario de prueba: cliente / Opel2026" FontSize="12"
                           Foreground="#777777" Margin="0,16,0,0" HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Grid>
</Page>