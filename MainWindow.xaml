<Window x:Class="OpelShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opel - Concesionario" Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource FondoApp}">
	<Window.Resources>
		<!-- Botón secundario con borde (para "Cerrar sesión") -->
		<Style x:Key="BotonSecundario" TargetType="Button">
			<Setter Property="Foreground" Value="{StaticResource Negro}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Borde" BorderBrush="{StaticResource Negro}"
                                BorderThickness="1" CornerRadius="4" Padding="12,6"
                                Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Borde" Property="Background" Value="#11000000"/>
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Cabecera común a todas las pantallas -->
		<Border Grid.Row="0" Background="White" Padding="24,10"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
			<DockPanel>
				<Image Source="Assets/LogoOpel.png" Height="40" DockPanel.Dock="Left"
                       ToolTip="Opel" AutomationProperties.Name="Logotipo de Opel"/>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
					<RadioButton x:Name="btnInicio" Content="Inicio" GroupName="Menu"
                                 IsChecked="True" Tag="Inicio.xaml" Click="Menu_Click"
                                 Style="{StaticResource BotonMenu}"/>
					<RadioButton x:Name="btnProductos" Content="Productos" GroupName="Menu"
                                 Tag="Galeria.xaml" Click="Menu_Click"
                                 Style="{StaticResource BotonMenu}"/>
					<RadioButton x:Name="btnAcceso" Content="Acceso" GroupName="Menu"
                                 Tag="Login.xaml" Click="Menu_Click"
                                 Style="{StaticResource BotonMenu}"/>

					<!-- Sesión iniciada (oculta hasta que alguien entra) -->
					<StackPanel x:Name="panelSesion" Orientation="Horizontal"
                                Visibility="Collapsed" Margin="16,0,0,0"
                                VerticalAlignment="Center">
						<TextBlock x:Name="txtUsuarioActual" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Negro}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
						<Button Content="Cerrar sesión" Click="CerrarSesion_Click"
                                Style="{StaticResource BotonSecundario}"/>
					</StackPanel>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- Aquí cambian las pantallas -->
		<Frame x:Name="Contenido" Grid.Row="1" NavigationUIVisibility="Hidden"/>
	</Grid>
</Window>