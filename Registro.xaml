<Page x:Class="OpelShop.Registro"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Crear cuenta">
    <Grid>
        <Border Width="400" Padding="32" Background="White" CornerRadius="8"
                   BorderBrush="#DDDDDD" BorderThickness="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Crear cuenta" FontSize="26" FontWeight="Bold"
                              Foreground="{StaticResource Negro}"/>
                <TextBlock Text="Regístrate para acceder a tus ofertas."
                              Margin="0,4,0,24" Foreground="#555555"/>

                <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsuario" Height="36" FontSize="16" Padding="8,6"
                            MaxLength="20" TabIndex="0" AutomationProperties.Name="Usuario"/>
                <TextBlock Text="Mínimo 3 caracteres, sin espacios." FontSize="12"
                              Foreground="#555555" Margin="0,4,0,0"/>

                <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <PasswordBox x:Name="txtClave" Height="36" FontSize="16" Padding="8,6"
                                MaxLength="30" TabIndex="1" AutomationProperties.Name="Contraseña"/>
                <TextBlock Text="Mínimo 6 caracteres." FontSize="12"
                              Foreground="#555555" Margin="0,4,0,0"/>

                <TextBlock Text="Repite la contraseña" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <PasswordBox x:Name="txtRepite" Height="36" FontSize="16" Padding="8,6"
                                MaxLength="30" TabIndex="2"
                                AutomationProperties.Name="Repite la contraseña"/>

                <!-- Mensaje de error (oculto por defecto) -->
                <Border x:Name="panelError" Visibility="Collapsed" Background="#FDECEA"
                           BorderBrush="#B00020" BorderThickness="1" CornerRadius="4"
                           Padding="10,8" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="#B00020" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtError" Foreground="#B00020"
                                      TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="290"/>
                    </StackPanel>
                </Border>

                <Button Content="Crear cuenta" IsDefault="True" Click="Crear_Click"
                           Style="{StaticResource BotonPrimario}" Margin="0,24,0,0" TabIndex="3"/>

                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center">
                       <Run Text="¿Ya tienes cuenta? "/>
                       <Hyperlink Click="IrLogin_Click" Foreground="{StaticResource Negro}"
                                  FontWeight="SemiBold">Inicia sesión</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>