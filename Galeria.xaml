<Page x:Class="OpelShop.Galeria"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Productos">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="32">

			<TextBlock Text="Nuestros modelos" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource Negro}"/>
			<TextBlock Text="Elige un tipo de motorización para filtrar el catálogo."
                       Foreground="#555555" Margin="0,4,0,20"/>

			<!-- Filtro por tipo -->
			<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
				<TextBlock Text="Tipo:" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
				<ComboBox x:Name="cmbTipo" Width="200" Height="34" FontSize="15"
                          SelectedIndex="0" SelectionChanged="Filtro_Changed"
                          AutomationProperties.Name="Filtrar por tipo de motor">
					<ComboBoxItem Content="Todos"/>
					<ComboBoxItem Content="Eléctrico"/>
					<ComboBoxItem Content="Híbrido"/>
					<ComboBoxItem Content="Gasolina"/>
				</ComboBox>
				<TextBlock x:Name="txtResultados" Foreground="#555555"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
			</StackPanel>

			<!-- Catálogo en 3 columnas que ocupan todo el ancho -->
			<ItemsControl x:Name="listaCoches" ItemTemplate="{StaticResource TarjetaCoche}"
                          Margin="-8,0,-8,0">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="3"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>

		</StackPanel>
	</ScrollViewer>
</Page>